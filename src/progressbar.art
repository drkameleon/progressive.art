;===============================================
; Progressive.art
;
; A customizeable, text-based 
; progress bar generator & library
; for Arturo
;
; MIT License
; (c) 2026 Yanis Zafirópulos
;-----------------------------------------------
; @file src/progressBar.art
;===============================================

define :progressbar [
    ;---------------------------
    ; Style templates
    ;---------------------------

    defaultStyle:   to :block read ./"styles/default.art"
    plainStyle:     to :block read ./"styles/plain.art"
    fancyStyle:     to :block read ./"styles/fancy.art"

    ;---------------------------
    ; Constructor
    ;---------------------------

    init: method [maxValue :integer, options :dictionary][
        ; initialize values
        \current: 0
        \maxValue: maxValue
        \run: 0

        ; initialize settings
        opts: extend #[
            label:          "Progress:"
            message:        ""
            timeLeftLabel:  "left"
            timeTakenLabel: "Completed in"
        ] options

        \label:             opts\label
        \message:           opts\message
        \timeLeftLabel:     opts\timeLeftLabel
        \timeTakenLabel:    opts\timeTakenLabel
        \processing:        ""
        \animated?:         true

        ; initialize style
        do \defaultStyle

        if key? opts 'plain -> do \plainStyle
        if key? opts 'fancy -> do \fancyStyle

        if key? opts 'animation     -> \animations:     opts\animation
        if key? opts 'barBefore     -> \barBefore:      opts\barBefore
        if key? opts 'barAfter      -> \barAfter:       opts\barAfter
        if key? opts 'onMark        -> \onMark:         opts\onMark
        if key? opts 'onColor       -> \onColor:        opts\onColor
        if key? opts 'offMark       -> \offMark:        opts\offMark
        if key? opts 'offColor      -> \offColor:       opts\offColor
        if key? opts 'headMark      -> \headMark:       opts\headMark
        if key? opts 'labelColor    -> \labelColor:     opts\labelColor
        if key? opts 'detailColor   -> \detailColor:    opts\detailColor
        if key? opts 'checkMark     -> \checkMark:      opts\checkMark
        if key? opts 'checkColor    -> \checkColor:     opts\checkColor
        if key? opts 'percentColor  -> \percentColor:   opts\percentColor

        \animated?:     not? key? opts 'static
        \hasBar?:       not? key? opts 'counter
        \hasRatio?:     not? key? opts 'ratioless
        \hasColor?:     not? key? opts 'colorless

        \hasDetails?:   not? key? opts 'simple
        \persistent?:   key? opts 'keep
        \hide?:         key? opts 'hide

        \animationSize:     \animated? ? -> inc size first \animations
                                         -> 0
        \percentageSize:    (and? \persistent? \hasBar?)? -> 6 -> 5

        ; let's start
        \startTime: to :integer now
        \active?: true

        ; hide the cursor
        cursor false
    ]

    ;---------------------------
    ; Helpers
    ;---------------------------

    width: function [][
       terminal\width
    ]

    space: function [spacelen][
        repeat " " spacelen
    ]
    
    neat: function [strblk][
        join.with:" " @ strblk
    ]

    colored: method [col, str][
        (or? col = #white not? \hasColor?)? -> str
                                            -> color col str
    ]

    friendlyTime: function [num][
        if null? num    -> return "?"
        if num = 0      -> return "< 1s"
        if num < 60     -> return ~"~ |num|s"
        if num = 60     -> return "< 1min"
        if num < 60*60  -> return ~"~ |num / 60|min |num % 60|s"
        if num = 60*60  -> return "< 1h"
        
        [hours,rest]    : divmod num 60*60
        [mins,secs]     : divmod rest 60 

        return ~"~ |hours|h |mins|min |secs|s"
    ]

    ;---------------------------
    ; Private methods
    ;---------------------------

    goBack: method [][
        prints repeat "\b" \width * enumerate @[\hasDetails? \hasBar?] => [&]
    ]

    cleanUp: method [][
        \goBack
        prints \space \width * enumerate @[\hasDetails? \hasBar?] => [&]
        \goBack
    ]

    timeLeft: method [][
        timeUpToNow: (to :integer now) - \startTime
        remaining: (zero? \current)? -> ø
                                     -> div (\maxValue - \current) * timeUpToNow \current
        return \neat [
            \friendlyTime remaining
            \timeLeftLabel
        ]
    ]

    timeTaken: method [][
        timeUpToNow: (to :integer now) - \startTime
        return \neat [
            \timeTakenLabel
            replace \friendlyTime timeUpToNow "~ " ""
        ]
    ]

    animation: method [][
        if and? not? \active? \animated? -> return \colored \checkColor " " ++ \checkMark
        \animated? ? -> " " ++ \animations\[\run % size \animations] 
                     -> ""
    ]

    percentage: method [][
        pad.left (to :string .format:".1f" round.to: 1 (\current * 100) // \maxValue) ++ "%" \percentageSize
    ]

    detailLine: method [][
        if not? \hasDetails? -> return ""

        dtlText: (\hasRatio? ? -> ~"|\current|/|\maxValue| ➔ " -> "") ++ \processing

        (not? \hasBar?)? 
            -> \neat [
                \animation
                \label
                \colored \detailColor dtlText
                pad.left \timeLeft \width - sum @[2 + size \label, size dtlText, \animationSize, 8]
                \colored \percentColor \percentage
            ]
            -> \neat [
                \space \animationSize + 1 + (size \label) + size \barBefore
                \colored \detailColor dtlText
                pad.left \timeLeft \width - sum @[2 + size \label, size dtlText, \animationSize, \percentageSize + 1, size \barBefore, size \barAfter, 2]
                \space 1 + \percentageSize + size \barAfter
            ]
    ]

    barSize: method [][
        \width - sum @[
            \animationSize
            inc size \label
            size \barBefore
            size \barAfter
            inc \percentageSize
            2 ; head-tail adjument
        ]
    ]

    bar: method [][
        ons: (\current * \barSize) / \maxValue
        offs: \barSize - ons

        ; attempt at gradient colors, etc :)
        ; pal: palette.monochrome.size: \barSize \onColor
        ; onBar: join map.with:'i  ons 'x -> color pal\[i] \onMark

        join @[
            \colored \labelColor \barBefore
            \colored \onColor repeat \onMark ons - (\active? ? -> size \headMark -> 0)
            (\active? ? -> \colored \onColor \headMark -> "")
            \colored \offColor repeat \offMark offs
            \colored \labelColor \barAfter
        ]
    ]

    barLine: method [][
        if not? \hasBar? -> return ""

        return \neat [
            \animation
            \colored.bold \labelColor \label
            \bar
            \colored \percentColor \percentage
        ]
    ]

    finalComplete: method [][
        (\hasDetails? ? 
            -> (
                (\space sum @[
                    \animationSize
                    inc size \label
                    size \barBefore
                    1
                ]) ++
                (\colored \detailColor \message) ++
                (\colored \detailColor pad.left \timeTaken \barSize - size \message) ++
                (\space 2 + \percentageSize + size \barAfter)
            ) 
            -> ""
        ) ++ \barLine
    ]

    finalMinimalist: method [][
        " " ++ \neat 
            rotate @[
                \colored.bold \labelColor \label
                \timeTaken
                \colored \checkColor \checkMark
            ] \animated? ? -> 2 -> 0
    ]

    ;---------------------------
    ; Public methods
    ;---------------------------

    increase: method [q :integer :floating][
        \current: \current + q
        if \animated? -> \run: \run + 1

        \goBack
        prints \detailLine
        prints \barLine

        if \current >= \maxValue [
            \active?: false
            \stop
        ]
    ]

    stop: method [][
        \cleanUp
        unless \hide? [
            print (and? \persistent? \hasBar?)?
                -> \finalComplete
                -> \finalMinimalist
        ]
        \active?: false
        cursor true
    ]
]