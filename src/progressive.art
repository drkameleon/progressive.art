;-----------------------------------------------
; @file src/progressive.art
;===============================================

import ./"progressbar"!

define :progressive [

    ;---------------------------
    ; Templates
    ;---------------------------

    initializeProgressBar: [
        maxLim: new \getMaxValue coll
        if and? [block? prm][1 < prmSize: <= size prm] ->
            'maxLim / prmSize

        \progressbar: to :progressbar @[maxLim opts]!
    ]

    internalFunctions: [
        processing: function [what][
            \progressbar\processing: to :string what
        ]
    ]
    
    mainLooper: [
        coll prm [
            do blk
            \progressbar\increase 1
        ]
        if \progressbar\active? ->
            \progressbar\stop
    ]

    ;---------------------------
    ; Helpers
    ;---------------------------

    getMaxValue: function [collection][
        getCollectionParamSize: function [c][
            if integer? c -> return c
            ; dictionaries & objects are iterated
            ; as a flat list of keys and values
            if or? dictionary? c object? c -> return 2 * size c
            size c
        ]

        unless literal? collection ->
            return getCollectionParamSize collection

        return getCollectionParamSize var collection
    ]

    iteratorCall: function [iter, par][
        if or? null? par false = par -> return @[to :word iter]
        if true = par -> return @[to :word iter, to :attribute "parallel"]
        @[to :word iter, to :attributeLabel "parallel", par]
    ]

    ;---------------------------
    ; Private methods
    ;---------------------------

    executeIterator: method [iter :literal, opts :dictionary][
        par: (key? opts 'parallel)? -> opts\parallel -> null
        if and? [not? null? par][and? [block? prm][1 < size prm]] ->
            throw "progressive: `.parallel` requires a single literal param (e.g. `'x`)"

        do \initializeProgressBar
        return \internalFunctions ++ 
               (\iteratorCall iter par) ++ 
                      \mainLooper
    ]

    ;---------------------------
    ; Public methods
    ;---------------------------

    ; Note: every public method grabs *all* of its attributes
    ; (via `attrs`) first thing, so that none of them leaks
    ; into any subsequent function call

    new: method [maximumValue :integer][
        to :progressbar @[maximumValue attrs]
    ]

    loop: method [coll, prm, blk][
        opts: attrs
        do \executeIterator 'loop opts
    ]

    map: method [coll, prm, blk][
        opts: attrs
        do \executeIterator 'map opts
    ]
    
    select: method [coll, prm, blk][
        opts: attrs
        do \executeIterator 'select opts
    ]

    filter: method [coll, prm, blk][
        opts: attrs
        do \executeIterator 'filter opts
    ]
]

;---------------------------
; The main access point
; = a singleton!
;---------------------------

progressive: to :progressive []!
